<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CodexPage · 更新" Width="520" Height="340" MinWidth="420" MinHeight="320" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#EDF4FC" Foreground="#172134" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><TextBlock x:Name="UpdateHeading" Text="正在更新 CodexPage" FontSize="22" FontWeight="SemiBold"/><Image x:Name="UpdateWordmark" Width="156" Height="36" HorizontalAlignment="Right" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="CodexPage"/></Grid>
  <ScrollViewer Grid.Row="1" MaxHeight="94" VerticalScrollBarVisibility="Auto" Margin="0,16,0,14"><TextBlock x:Name="InstallStatus" Text="正在准备安装…" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></ScrollViewer>
  <ProgressBar x:Name="InstallProgress" Grid.Row="2" Height="8" Minimum="0" Maximum="100" IsIndeterminate="True" Foreground="#3564DC" Background="#DCE6F1" AutomationProperties.Name="更新进度"/>
  <TextBlock x:Name="InstallDetail" Grid.Row="3" Text="壁纸收藏和设置会保留，更新完成后自动打开 CodexPage。" Foreground="#526B89" TextWrapping="Wrap" Margin="0,16,0,12"/>
  <Button x:Name="ReturnButton" Grid.Row="4" Content="返回 CodexPage" Visibility="Collapsed" HorizontalAlignment="Right" Padding="16,8" MinHeight="36"/>
 </Grid>
</Window>
