<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex 皮肤管理中心" Width="1440" Height="840" MinWidth="1080" MinHeight="720" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip" Background="Transparent" Foreground="#172134" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
 <Window.Resources>
  <SolidColorBrush x:Key="MutedBrush" Color="#637B9E"/>
  <Style TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#172134"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="20,12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="24" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#272B31"/><Setter Property="Foreground" Value="White"/></Style>
  <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="12,8"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,0,16,18"/><Setter Property="Padding" Value="3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tile" BorderBrush="Transparent" BorderThickness="2" CornerRadius="17" Padding="{TemplateBinding Padding}"><Grid><ContentPresenter/><Border x:Name="SelectedMark" Width="23" Height="23" Background="White" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Visibility="Collapsed"><TextBlock Text="✓" Foreground="#202B3A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/><Setter TargetName="Tile" Property="BorderBrush" Value="#235CFF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#BBD9F5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border CornerRadius="26" BorderBrush="#F2FFFFFF" BorderThickness="1" Padding="26,24,26,22">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F1F8FF" Offset="0"/><GradientStop Color="#E0EEFC" Offset="0.48"/><GradientStop Color="#EDF7FF" Offset="1"/></LinearGradientBrush></Border.Background>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="128"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="TitleDragArea" Grid.ColumnSpan="2" Background="Transparent" Margin="0,0,0,16"/>
  <StackPanel Margin="4,3" IsHitTestVisible="False"><TextBlock Text="Codex" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="皮肤管理中心" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button x:Name="ImportButton" Content="＋  导入壁纸" FontSize="14" FontWeight="SemiBold" Padding="20,11"/><Button x:Name="SettingsButton" Content="•••" Style="{StaticResource TextButton}" Margin="12,0,12,0" ToolTip="管理与更新"/><Border Width="1" Height="28" Background="#C9DDF4" Margin="0,0,10,0"/><Button x:Name="MinimizeButton" Content="−" FontSize="22" Style="{StaticResource TextButton}" Width="44"/><Button x:Name="MaximizeButton" Content="□" FontSize="21" Style="{StaticResource TextButton}" Width="44"/><Button x:Name="CloseWindowButton" Content="×" FontSize="26" Style="{StaticResource TextButton}" Width="44"/></StackPanel>
  <Grid Grid.Row="1" Width="184" Height="140" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,90">
   <Border x:Name="NavThumb" Height="60" CornerRadius="30" Background="White" VerticalAlignment="Top" IsHitTestVisible="False"><Border.RenderTransform><TranslateTransform x:Name="NavThumbTransform"/></Border.RenderTransform></Border>
   <Button x:Name="LocalNavButton" Height="60" VerticalAlignment="Top" Padding="12" Background="Transparent" ToolTip="本地壁纸"><StackPanel Orientation="Horizontal"><Viewbox x:Name="LocalNavIcon" Width="32" Height="32" Margin="0,0,12,0"><Canvas Width="32" Height="32"><Rectangle Width="30" Height="30" RadiusX="5" RadiusY="5" Fill="#687BFF"/><Rectangle Canvas.Left="3" Canvas.Top="3" Width="24" Height="24" RadiusX="2" RadiusY="2" Fill="White"/><Ellipse Canvas.Left="7" Canvas.Top="7" Width="5" Height="5" Fill="#8B9BFF"/><Path Data="M3,24 L12,14 L18,20 L23,14 L27,18 L27,27 L3,27 Z" Fill="#687BFF"/></Canvas></Viewbox><TextBlock x:Name="LocalNavLabel" Text="本地壁纸" FontSize="15" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Button>
   <Button x:Name="EngineNavButton" Height="60" VerticalAlignment="Bottom" Padding="12" Background="Transparent" ToolTip="Wallpaper Engine"><StackPanel Orientation="Horizontal"><Border x:Name="EngineNavIcon" Width="32" Height="32" CornerRadius="7" Background="#0754DF"><Grid><Rectangle Width="23" Height="19" Stroke="White" StrokeThickness="2" RadiusX="2" RadiusY="2"/><TextBlock Text="⚙" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><TextBlock x:Name="EngineNavLabel" Text="Wallpaper Engine" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed"/></StackPanel></Button>
  </Grid>
  <StackPanel Grid.Row="2" Width="110" HorizontalAlignment="Left" VerticalAlignment="Bottom"><Grid Width="82" Height="78" HorizontalAlignment="Center"><Button x:Name="OpenButton" Padding="12" Background="White" ToolTip="正在检测 Codex 连接…"><Grid><TextBlock x:Name="CodexIconFallback" Text="›_" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="CodexIcon" Width="54" Height="54"/><Grid x:Name="ConnectionLoading" Visibility="Collapsed" Background="#DDFFFFFF"><Path Data="M 27,4 A 23,23 0 1 1 4,27" Stroke="#537BEE" StrokeThickness="3" Width="54" Height="54" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform x:Name="ConnectionSpinner"/></Path.RenderTransform></Path></Grid></Grid></Button><Border x:Name="ConnectionBadge" Width="23" Height="23" CornerRadius="12" Background="#2CC17C" BorderBrush="White" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-5,0" Visibility="Collapsed"><TextBlock x:Name="ConnectionBadgeText" Text="✓" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid><TextBlock x:Name="ConnectionLabel" Text="正在连接…" HorizontalAlignment="Center" FontSize="12" Margin="0,7,0,0"/><TextBlock x:Name="ConnectionDetail" Text="请稍候" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
  <Grid Grid.Row="1" Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel x:Name="EngineToolbar" Visibility="Collapsed" Margin="0,0,16,12"><WrapPanel><Button x:Name="EngineImportButton" Content="导入本地 Wallpaper Engine 壁纸" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"/><Button x:Name="EngineFolderButton" Content="选择壁纸目录…"/></WrapPanel><TextBox x:Name="EngineReport" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" MaxHeight="65" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/></StackPanel>
   <ListBox x:Name="WallpaperList" Grid.Row="1" Foreground="White" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single">
    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemTemplate><DataTemplate><Grid Width="{Binding CardWidth}" Height="{Binding CardHeight}"><Grid><Border x:Name="CardRoundMask" Background="White" CornerRadius="12"/><Grid Background="#C5D9EF"><Grid.OpacityMask><VisualBrush Visual="{Binding ElementName=CardRoundMask}"/></Grid.OpacityMask><TextBlock Text="{Binding Placeholder}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#637B9E"/><Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill"/><Border VerticalAlignment="Bottom" Height="62"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00101C32"/><GradientStop Color="#CD101C32" Offset="1"/></LinearGradientBrush></Border.Background></Border><TextBlock Text="{Binding Name}" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="14,0,46,14" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/><Border Width="28" Height="28" BorderBrush="#CCFFFFFF" BorderThickness="1.5" CornerRadius="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12"><TextBlock Text="▷" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Background="White" CornerRadius="12" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Visibility="{Binding CurrentVisibility}"><TextBlock Text="✓" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Grid></Grid></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock x:Name="EmptyTitle" Text="你的壁纸收藏，从这里开始" FontSize="20"/><TextBlock Text="导入图片或视频，点击卡片预览效果。" Foreground="{StaticResource MutedBrush}" Margin="0,12"/></StackPanel>
   <Border x:Name="EnginePanel" Grid.Row="1" Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620"><TextBlock Text="Wallpaper Engine" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="点击上方导入，自动寻找本地 Steam 壁纸。" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,12"/><TextBlock Text="也可手动选择改名后的壁纸目录或单个项目目录。" Foreground="{StaticResource MutedBrush}" TextAlignment="Center"/><TextBlock Text="支持视频和图片。Scene、Web 和应用类型暂不支持。" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,16"/></StackPanel></Border>
  </Grid>
  <Grid Grid.Row="2" Grid.Column="1" Margin="0,18,16,0"><Border Background="#D6E4F5" CornerRadius="25" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="3"><Grid Width="216" Height="44"><Border x:Name="FilterThumb" Width="108" CornerRadius="22" Background="White" HorizontalAlignment="Left" IsHitTestVisible="False"><Border.RenderTransform><TranslateTransform x:Name="FilterThumbTransform"/></Border.RenderTransform></Border><StackPanel Orientation="Horizontal"><Button x:Name="VideoFilter" Content="动态" Width="108" Height="44" Background="Transparent" FontSize="15" FontWeight="SemiBold"/><Button x:Name="ImageFilter" Content="静态" Width="108" Height="44" FontSize="15" FontWeight="SemiBold" Background="Transparent"/></StackPanel></Grid></Border><Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="28,13"><StackPanel Orientation="Horizontal"><TextBlock Text="✦" FontSize="28" Margin="0,0,16,0"/><TextBlock Text="应用到Codex" FontSize="18" VerticalAlignment="Center"/></StackPanel></Button></Grid>
  <StackPanel Grid.Row="3" Grid.ColumnSpan="2"><ProgressBar x:Name="WorkProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,5,0,0"/></StackPanel>
  <Border x:Name="SettingsPanel" Grid.RowSpan="3" Grid.Column="1" Background="#F6FAFF" CornerRadius="18" Padding="24" HorizontalAlignment="Right" VerticalAlignment="Top" Width="430" Visibility="Collapsed" Margin="0,50,0,0">
   <StackPanel><TextBlock Text="管理与更新" FontSize="20" Margin="0,0,0,16"/><TextBlock x:Name="LibrarySummary"/><TextBlock x:Name="ConnectionText" TextWrapping="Wrap" Margin="0,10"/><WrapPanel><Button x:Name="OpenCodexButton" Content="打开 Codex" Style="{StaticResource TextButton}"/><Button x:Name="AllFilter" Content="显示全部壁纸" Style="{StaticResource TextButton}"/><Button x:Name="DetectButton" Content="重新检测" Style="{StaticResource TextButton}"/><Button x:Name="SaveCurrentButton" Content="保存当前背景" Style="{StaticResource TextButton}"/><Button x:Name="RestoreButton" Content="恢复原始外观" Style="{StaticResource TextButton}"/><Button x:Name="CheckUpdateButton" Content="检查更新" Style="{StaticResource TextButton}"/></WrapPanel><TextBlock x:Name="UpdateText" TextWrapping="Wrap"/><Border x:Name="UpdateBanner" Visibility="Collapsed" Padding="0,12"><StackPanel><ScrollViewer MaxHeight="160"><TextBlock x:Name="UpdateNotes" TextWrapping="Wrap"/></ScrollViewer><TextBlock Text="下载并安装后重新打开管理中心，保留壁纸库与设置。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,14"/><WrapPanel><Button x:Name="InstallUpdateButton" Content="下载并更新" Style="{StaticResource PrimaryButton}"/><Button x:Name="LaterUpdateButton" Content="稍后"/><Button x:Name="SkipUpdateButton" Content="跳过此版本"/></WrapPanel></StackPanel></Border></StackPanel>
  </Border>
  <Border x:Name="PreviewOverlay" Grid.RowSpan="4" Grid.ColumnSpan="2" Background="#232C3C" CornerRadius="20" Padding="18" Visibility="Collapsed">
   <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="60"/></Grid.RowDefinitions>
    <TextBlock x:Name="SelectedName" Foreground="White" FontSize="20" VerticalAlignment="Top"/><Button x:Name="ClosePreviewButton" Content="关闭预览  ×" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="16,8"/>
    <Border x:Name="GalleryPreview" Grid.Row="1" Background="#151B27" CornerRadius="10" ClipToBounds="True"><Grid>
     <TextBlock x:Name="PreviewPlaceholder" Text="预览暂不可用" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="PreviewImage" Stretch="UniformToFill"/><MediaElement x:Name="PreviewVideo" LoadedBehavior="Manual" UnloadedBehavior="Close" IsMuted="True" Stretch="UniformToFill" Visibility="Collapsed"/>
     <Border Background="#990A1020"/>
     <Grid IsHitTestVisible="False"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#70303948"><TextBlock Text="‹     ›        文件      编辑      视图      帮助" Foreground="#AAB8CD" Margin="16,10"/></Border><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#50303948"><TextBlock Text="⌂&#10;&#10;▱&#10;&#10;◷&#10;&#10;▥&#10;&#10;•••" Foreground="#AAB8CD" FontSize="22" TextAlignment="Center" Margin="0,20"/></Border><Grid Grid.Column="1"><TextBlock Text="▢  聊天" Foreground="#DBE4EF" Margin="22,18"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,60"><TextBlock Text="›_" Foreground="#C4CEDF" FontSize="46" HorizontalAlignment="Center"/><TextBlock Text="你想让我们构建什么？" Foreground="White" FontSize="28" Margin="0,20"/></StackPanel><Border Background="#E62C3039" CornerRadius="20" MaxWidth="700" Height="130" VerticalAlignment="Bottom" Margin="40,0,40,28" Padding="20"><Grid><TextBlock Text="⌑  此计算机" Foreground="#CED7E6"/><TextBlock Text="随心输入" Foreground="#8D97A7" Margin="0,36,0,0"/><TextBlock Text="＋                                                  ↑" Foreground="White" VerticalAlignment="Bottom"/></Grid></Border></Grid></Grid></Grid>
    </Grid></Border>
    <Grid Grid.Row="2" Margin="0,12,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="PlayButton" Content="播放预览" Visibility="Collapsed"/><Button x:Name="RenameButton" Content="重命名" Margin="8,0"/><Button x:Name="DeleteButton" Content="删除"/><TextBlock x:Name="PreviewNotice" Foreground="#BFCDE1" VerticalAlignment="Center" Margin="16,0" MaxWidth="430" TextWrapping="Wrap"/></StackPanel><Button x:Name="PreviewApplyButton" Content="应用到 Codex" HorizontalAlignment="Right"/></Grid>
    <StackPanel x:Name="GalleryDetails" Visibility="Collapsed"><TextBlock x:Name="SelectedDetails"/><TextBlock x:Name="SelectedFormat"/><TextBlock x:Name="SelectedSize"/><TextBlock x:Name="SelectedImportedAt"/><TextBlock x:Name="SelectedStatus"/></StackPanel>
   </Grid>
  </Border>
  <Border x:Name="ConfirmationOverlay" Grid.RowSpan="4" Grid.ColumnSpan="2" Background="#601D2D45" CornerRadius="18" Visibility="Collapsed">
   <Border Width="440" Padding="28" CornerRadius="28" Background="#FCFEFF" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid><Button x:Name="ConfirmCloseButton" Content="×" Style="{StaticResource TextButton}" FontSize="22" Foreground="#8590A2" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0" Width="24" Height="24"/>
     <StackPanel Margin="0,14,0,0"><TextBlock Text="✦" FontSize="42" Foreground="#7182FF" HorizontalAlignment="Center"/><TextBlock x:Name="ConfirmationTitle" Text="应用这张壁纸？" FontWeight="SemiBold" FontSize="22" TextAlignment="Center" Margin="0,8,0,12"/><TextBlock x:Name="ConfirmationMessage" Text="保存当前工作后继续，可能需要重启 Codex。" FontSize="13" Foreground="#7D8799" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,26"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="ConfirmCancelButton" Content="取消" Background="#E9EDF3" Height="48"/><Button x:Name="ConfirmAcceptButton" Content="确认" Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="48"/></Grid></StackPanel>
    </Grid>
   </Border>
  </Border>
  <Border x:Name="ToastPanel" Grid.RowSpan="4" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Width="360" CornerRadius="22" Background="#FCFEFF" Padding="18,16" Margin="0,65,20,0" Visibility="Collapsed" IsHitTestVisible="False"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="ToastIconBorder" Width="25" Height="25" Background="#2CC17C" CornerRadius="13"><TextBlock x:Name="ToastIcon" Text="✓" FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="ToastMessage" Text="壁纸已应用" FontSize="14" FontWeight="SemiBold" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid></Border>
 </Grid>
 </Border>
</Window>
